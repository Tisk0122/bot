# =============================
# 必須設定
# =============================

# Discord Bot のトークン
DISCORD_TOKEN=your_discord_bot_token_here

# Bot の Application ID
CLIENT_ID=your_client_id_here

# 対象サーバーの Guild ID
GUILD_ID=your_guild_id_here

# =============================
# チャンネル / ロール ID
# =============================

# ログを送信するチャンネル ID
LOG_CHANNEL_ID=your_log_channel_id_here

# 認証チャンネルの ID
VERIFICATION_CHANNEL_ID=your_verification_channel_id_here

# 認証申請（承認・拒否ボタン）を送るチャンネル
# MODERATION_CHANNEL_ID=your_moderation_channel_id_here

# BAN管理・BANリストのチャンネル
# BAN_CHANNEL_ID=your_ban_channel_id_here

# 認証完了時に付与するロール
# VERIFIED_ROLE_ID=your_verified_role_id_here

# おべんきょVC のチャンネル ID
STUDY_VC_ID=your_study_vc_channel_id_here

# おべんきょVC の入退室ログチャンネル ID
STUDY_LOG_CHANNEL_ID=your_study_log_channel_id_here

# 管理者ロールの ID（任意。未設定の場合はDiscord標準の「管理者」権限で判定）
# ADMIN_ROLE_ID=your_admin_role_id_here

# =============================
# 勉強ロール設定
# =============================

# 勉強ロールの名前。デフォルト: 勉強中
# STUDY_ROLE_NAME=勉強中

# チャンネル・ロール設定は管理者ダッシュボードの「サーバー設定」から変更できます。
# 保存後は data/guild_config.json に永続化され、環境変数の初期値より優先されます。
# guild_config.json はデータ管理からバックアップ／復元できます。

# =============================
# Web サーバー / ダッシュボード
# =============================

# Web サーバーのポート。デフォルト: 8000
# PORT=8000

# Keep-Alive 用アプリ URL (Koyeb 等のホスティングサービスで使用)
# APP_URL=https://your-app-name.koyeb.app

# 管理者ダッシュボードのパスワード (必ず固有の長い値に変更。未設定だとダッシュボード無効)
# DASHBOARD_PASSWORD=ここに十分に長いランダムなパスワードを設定

# 管理者ダッシュボードのユーザー名。デフォルト: admin
# DASHBOARD_USERNAME=admin

# Discord公式ステータス監視（省略時は既定値を使用）
# 公式ステータス画像と障害通知を投稿するチャンネルID
# DISCORD_STATUS_CHANNEL_ID=通知先チャンネルID
# 監視頻度（ミリ秒、最短30秒）
# DISCORD_STATUS_POLL_INTERVAL_MS=60000
# Statuspage API v2 のベースURL（通常は変更不要）
# DISCORD_STATUS_API_BASE_URL=https://discordstatus.com/api/v2
# APIリクエストのタイムアウト（ミリ秒）
# DISCORD_STATUS_REQUEST_TIMEOUT_MS=12000
# 一時的な通信エラー時の再試行回数（0～4）
# DISCORD_STATUS_REQUEST_RETRIES=2
# API取得失敗通知を送る連続失敗回数
# DISCORD_STATUS_FAILURE_ALERT_THRESHOLD=2
# data/discord_status_state.json を永続ストレージに保存してください。
