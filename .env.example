# =============================
# 必須設定
# =============================

# Discord Bot のトークン
DISCORD_TOKEN=your_discord_bot_token_here

# Bot の Application ID
CLIENT_ID=your_client_id_here

# 対象サーバーの Guild ID
GUILD_ID=your_guild_id_here

# =============================
# チャンネル / ロール ID
# =============================

# ログを送信するチャンネル ID
LOG_CHANNEL_ID=your_log_channel_id_here

# 認証チャンネルの ID
VERIFICATION_CHANNEL_ID=your_verification_channel_id_here

# おべんきょVC のチャンネル ID
STUDY_VC_ID=your_study_vc_channel_id_here

# おべんきょVC の入退室ログチャンネル ID
STUDY_LOG_CHANNEL_ID=your_study_log_channel_id_here

# AFK チャンネルの ID
AFK_CHANNEL_ID=your_afk_channel_id_here

# AFK タイムアウト（分）。デフォルト: 30
# AFK_TIMEOUT_MINUTES=30

# 管理者ロールの ID
ADMIN_ROLE_ID=your_admin_role_id_here

# =============================
# 勉強ロール設定
# =============================

# 勉強ロールの名前。デフォルト: 勉強中
# STUDY_ROLE_NAME=勉強中

# =============================
# Web サーバー / ダッシュボード
# =============================

# Web サーバーのポート。デフォルト: 8000
# PORT=8000

# Keep-Alive 用アプリ URL (Koyeb 等のホスティングサービスで使用)
# APP_URL=https://your-app-name.koyeb.app

# 管理者ダッシュボードのパスワード (未設定だとダッシュボード無効)
DASHBOARD_PASSWORD=your_secure_password_here

# 管理者ダッシュボードのユーザー名。デフォルト: admin
# DASHBOARD_USERNAME=admin
